generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ────────────────────────────────────────────────────────────────────────────
// Stage 1 writes ALL models at once so Stages 2/3 never migrate under pressure.
// ────────────────────────────────────────────────────────────────────────────

// ── Enums ─────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  INTERNAL
  PORTAL
}

enum Period {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  DRAFT
  QUOTATION
  CONFIRMED
  ACTIVE
  PAUSED
  CLOSED
}

enum InvoiceStatus {
  DRAFT
  CONFIRMED
  PAID
  CANCELLED
}

enum DiscountType {
  FIXED
  PERCENT
}

enum DiscountScope {
  PRODUCT
  SUBSCRIPTION
}

// ── User ──────────────────────────────────────────────────────────────────

model User {
  id           Int       @id @default(autoincrement())
  email        String    @unique
  passwordHash String
  name         String
  role         Role      @default(PORTAL)
  customerId   Int?
  customer     Customer? @relation(fields: [customerId], references: [id])
  resetToken   String?   @unique
  resetExpires DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// ── Customer ──────────────────────────────────────────────────────────────

model Customer {
  id            Int            @id @default(autoincrement())
  name          String
  email         String         @unique
  phone         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  users         User[]
  subscriptions Subscription[]
  invoices      Invoice[]
}

// ── Product + variants ────────────────────────────────────────────────────

model Product {
  id                Int                @id @default(autoincrement())
  name              String
  type              String             @default("service")
  salesPrice        Decimal            @db.Decimal(12, 2)
  costPrice         Decimal            @default(0) @db.Decimal(12, 2)
  notes             String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  attributeValues   AttributeValue[]
  subscriptionLines SubscriptionLine[]
  discounts         Discount[]
}

model AttributeValue {
  id                Int                @id @default(autoincrement())
  productId         Int
  product           Product            @relation(fields: [productId], references: [id])
  attribute         String             // e.g. "Brand"
  value             String             // e.g. "Odoo"
  extraPrice        Decimal            @default(0) @db.Decimal(12, 2)
  createdAt         DateTime           @default(now())
  subscriptionLines SubscriptionLine[]

  @@unique([productId, attribute, value])
}

// ── Plan ──────────────────────────────────────────────────────────────────

model Plan {
  id            Int             @id @default(autoincrement())
  name          String
  price         Decimal         @db.Decimal(12, 2)
  period        Period          @default(MONTHLY)
  minQty        Int             @default(1)
  startDate     DateTime?
  endDate       DateTime?
  autoClose     Boolean         @default(false)
  closable      Boolean         @default(true)
  pausable      Boolean         @default(false)
  renewable     Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  subscriptions Subscription[]
  templates     QuoteTemplate[]
}

// ── Tax ───────────────────────────────────────────────────────────────────

model Tax {
  id                Int                @id @default(autoincrement())
  name              String
  percent           Decimal            @db.Decimal(5, 2)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  subscriptionLines SubscriptionLine[]
}

// ── PaymentTerm ───────────────────────────────────────────────────────────

model PaymentTerm {
  id            Int            @id @default(autoincrement())
  name          String
  dueDays       Int
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  subscriptions Subscription[]
}

// ── QuoteTemplate (Stage 2 uses; Stage 1 creates the model) ──────────────

model QuoteTemplate {
  id           Int      @id @default(autoincrement())
  name         String
  planId       Int
  plan         Plan     @relation(fields: [planId], references: [id])
  validityDays Int      @default(30)
  // lines: [{ productId, attributeValueId?, qty }]
  lines        Json
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ── Subscription ──────────────────────────────────────────────────────────

model Subscription {
  id              Int                @id @default(autoincrement())
  number          String             @unique // SUB-0001
  customerId      Int
  customer        Customer           @relation(fields: [customerId], references: [id])
  planId          Int
  plan            Plan               @relation(fields: [planId], references: [id])
  startDate       DateTime
  expiryDate      DateTime?
  paymentTermId   Int?
  paymentTerm     PaymentTerm?       @relation(fields: [paymentTermId], references: [id])
  status          SubscriptionStatus @default(DRAFT)
  nextInvoiceDate DateTime?
  quoteValidUntil DateTime? // Stage 3: set from template validityDays; confirm blocked after it
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  lines           SubscriptionLine[]
  invoices        Invoice[]

  @@index([status])
  @@index([customerId])
  @@index([nextInvoiceDate])
}

// ── SubscriptionLine ──────────────────────────────────────────────────────

model SubscriptionLine {
  id               Int             @id @default(autoincrement())
  subscriptionId   Int
  subscription     Subscription    @relation(fields: [subscriptionId], references: [id])
  productId        Int
  product          Product         @relation(fields: [productId], references: [id])
  attributeValueId Int?
  attributeValue   AttributeValue? @relation(fields: [attributeValueId], references: [id])
  qty              Int             @default(1)
  unitPrice        Decimal         @db.Decimal(12, 2)
  taxId            Int?
  tax              Tax?            @relation(fields: [taxId], references: [id])
  // amount = qty * unitPrice (pre-tax, post-discount)
  amount           Decimal         @db.Decimal(12, 2)
}

// ── Discount ──────────────────────────────────────────────────────────────

model Discount {
  id          Int           @id @default(autoincrement())
  name        String
  type        DiscountType  // FIXED | PERCENT
  value       Decimal       @db.Decimal(12, 2)
  minQty      Int?
  minPurchase Decimal?      @db.Decimal(12, 2)
  startDate   DateTime?
  endDate     DateTime?
  usageLimit  Int?
  usageCount  Int           @default(0)
  scope       DiscountScope @default(SUBSCRIPTION)
  productId   Int?
  product     Product?      @relation(fields: [productId], references: [id])
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

// ── Invoice ───────────────────────────────────────────────────────────────
// billedPeriod is a nullable copy of periodStart.
// The unique constraint on (subscriptionId, billedPeriod) prevents double-billing.
// Postgres treats NULLs as distinct → setting billedPeriod=null on cancel frees the period.

model Invoice {
  id             Int           @id @default(autoincrement())
  number         String        @unique // INV-0001
  subscriptionId Int
  subscription   Subscription  @relation(fields: [subscriptionId], references: [id])
  customerId     Int
  customer       Customer      @relation(fields: [customerId], references: [id])
  periodStart    DateTime
  periodEnd      DateTime
  billedPeriod   DateTime?     // null after cancel so the period can be re-billed
  invoiceDate    DateTime      @default(now())
  dueDate        DateTime
  status         InvoiceStatus @default(DRAFT)
  subtotal       Decimal       @default(0) @db.Decimal(12, 2)
  discountTotal  Decimal       @default(0) @db.Decimal(12, 2)
  taxTotal       Decimal       @default(0) @db.Decimal(12, 2)
  total          Decimal       @default(0) @db.Decimal(12, 2)
  amountPaid     Decimal       @default(0) @db.Decimal(12, 2)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  lines          InvoiceLine[]
  payments       Payment[]

  // Prevents double-billing; NULLs don't conflict in Postgres
  @@unique([subscriptionId, billedPeriod])
  @@index([status, dueDate])
  @@index([customerId])
}

// ── InvoiceLine ───────────────────────────────────────────────────────────

model InvoiceLine {
  id          Int     @id @default(autoincrement())
  invoiceId   Int
  invoice     Invoice @relation(fields: [invoiceId], references: [id])
  description String
  qty         Int     @default(1)
  unitPrice   Decimal @db.Decimal(12, 2)
  discount    Decimal @default(0) @db.Decimal(12, 2)
  tax         Decimal @default(0) @db.Decimal(12, 2)
  amount      Decimal @db.Decimal(12, 2)
}

// ── Payment ───────────────────────────────────────────────────────────────

model Payment {
  id        Int      @id @default(autoincrement())
  invoiceId Int
  invoice   Invoice  @relation(fields: [invoiceId], references: [id])
  method    String   @default("cash") // cash | bank_transfer | card
  amount    Decimal  @db.Decimal(12, 2)
  date      DateTime @default(now())
  note      String?
  createdAt DateTime @default(now())

  @@index([invoiceId])
}
